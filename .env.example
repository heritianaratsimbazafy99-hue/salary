NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL="MadajobPay <notifications@your-verified-domain.tld>"
# Optional monitored reply address, e.g. support@your-domain.tld.
# Leave blank to use the existing public support contact from src/lib/support.ts.
RESEND_REPLY_TO_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel Cron bearer secret for HR alerts and monthly reports (at least 32 random characters).
CRON_SECRET=

# Sentry monitoring. Keep auth tokens server/build-only.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=stark-3t
SENTRY_PROJECT=salary
SENTRY_AUTH_TOKEN=
